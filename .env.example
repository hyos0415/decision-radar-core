# 제품(product/) API 키 — 이 파일을 .env로 복사해 값을 채운다. .env는 gitignore (커밋 금지)
# 스킬·eval(claude -p)은 구독을 쓰므로 여기 키가 필요 없다
# 역할별 모델: docs/design/overview.md §7 멀티 모델

# 비교 모드 모델 (Claude Sonnet 5.5 · effort medium) — 런타임 스파이크 P3·실제 실행 (HYO-63·64)
ANTHROPIC_API_KEY=

# Google AI Studio 키 (overview Q2) — 다른 회사 LLM judge (HYO-20·25), Arena 임베딩 변형 (retrieval-arena S4 변형)
# 지금은 비워 둬도 된다
GEMINI_API_KEY=

# OpenAI — 지금은 넣지 않는다. Agents SDK는 이 키가 있으면 트레이스를 OpenAI로 올리려 한다 (런타임 스파이크 P5).
# 최적화 모드(GPT-6 Luna, ADR 0007)·judge 후보를 시작할 때 주석을 푼다 (HYO-46)
# OPENAI_API_KEY=
