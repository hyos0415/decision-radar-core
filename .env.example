# 제품·실험의 API 키 — 이 파일을 .env로 복사해 값을 채운다. .env는 gitignore (커밋 금지)
# 스킬·eval(claude -p)과 judge·tier-screen(codex exec)은 구독을 쓰므로 여기 키가 필요 없다
# 키는 product/spike/common/env.py load_dotenv가 읽기만 하고 os.environ에 넣지 않는다 — radar.py 같은 하위 프로세스로 흐르지 않는다
# 역할별 모델: docs/design/overview.md §7 멀티 모델

# 비교 모드 — Claude Sonnet 5.5 · effort medium (LangGraph, ADR 0009). 제품 eval·W4 게이트(HYO-48)
ANTHROPIC_API_KEY=

# 최적화 모드 — Agents SDK + GPT (ADR 0008). 레인 A 중요도 분류기 첫 자리(HYO-67): GPT-6 Luna → GPT-6.1 Sol
# 이 용도로 따로 만든 OpenAI 프로젝트의 키를 쓴다 (사용자 2026-10-06 — 사용량·비용을 따로 본다)
# SDK 트레이싱은 켠다(ADR 0008) — 이 키로 트레이스가 그 프로젝트에 올라간다. 비교 모드 경로는 이 키를 읽지 않는다
OPENAI_API_KEY=

# TypeSafe Jev — 레인 A 분류기의 세 번째 비교 대상(HYO-67, 사용자 2026-10-06). 백엔드는 아직 없다 (키 받은 뒤 붙인다)
# 이 용도로 따로 발급한다. finance_verifier의 side check(ADR 0001)와 키를 나누지 않는다
TYPESAFE_API_KEY=

# Google AI Studio — 다른 회사 LLM judge (HYO-20·25), Arena 임베딩 변형 (retrieval-arena S4 변형). 지금은 비워 둬도 된다
GEMINI_API_KEY=

# Hugging Face 읽기 전용 토큰 — Arena S3a SPLADE-v3(`naver/splade-v3`)가 게이트 모델이라 필요하다 (HYO-35)
# 1) https://huggingface.co/naver/splade-v3 에서 라이선스 동의(비상업) 2) https://huggingface.co/settings/tokens 에서 Read 토큰
# 다른 Arena 모델(BAAI/bge-m3 · bge-reranker-v2-m3)은 토큰 없이 받는다. 하네스가 이 값을 모델 다운로드 호출에만 넘긴다
HF_TOKEN=

# ── 아래는 .env가 아니라 셸 환경 변수다 (참고용 목록 — 이 파일에 적어도 읽히지 않는다) ──
# RADAR_ADR_DIR · RADAR_TARGETS          스킬·수집기·제품 공통: ADR 폴더 · 대상 repo 목록(radar-targets.json)
# RADAR_PROFILE                          수집 필터 프로필(ADR repo radar-profile.yaml) — pipeline/
# RADAR_SNAPSHOT_REPO                    주간 스냅숏 data repo (기본 ../radar-snapshots) — collector/snapshot.py
# RADAR_SNAPSHOT_DIR · RADAR_SERVED_LOG  eval 스냅숏 모드 (스킬·제품 eval 러너가 넣는다)
# RADAR_DRY_RUN=1                        원격 부작용 0 (eval 러너가 넣는다)
# RADAR_FINGERPRINT=all|related          HITL 재개 지문 — 기본 all(A′), 거슬리면 related(B′) (hitl-state 결정 7)
# RADAR_EXPORT=git                       승인한 항목을 ADR repo main에 커밋·push (hitl-state 결정 8, 기본 꺼짐)
# RADAR_EXPORT_REMOTE · RADAR_EXPORT_BRANCH · RADAR_GIT_NAME · RADAR_GIT_EMAIL   내보내기 원격·브랜치·커밋 작성자

# Linear 개인 API 키 — 출처 건강 검사 알림(HYO-172, collector/health.py). 수집 PC에만 둔다. 없으면 알림만 건너뛴다
# https://linear.app/settings/account/security → Personal API keys. 권한은 이슈 · 댓글 쓰기면 된다
LINEAR_API_KEY=
